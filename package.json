{
  "name": "personal-finance-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend hệ thống sổ thu chi cá nhân - TASK_00030",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.mts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.mts",
    "start": "node dist/src/server.js",
    "test": "vitest run --coverage",
    "test:web": "vitest run --config web/vitest.config.mts",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-live.mjs",
    "test:ui": "node scripts/ui-e2e.mjs",
    "test:agent": "node scripts/e2e-agent.mjs",
    "docs:openapi": "tsx scripts/export-openapi.ts",
    "logs": "docker compose logs --follow --tail 100 api",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "node dist/prisma/seed.js",
    "vip:grant": "tsx prisma/vip.ts grant",
    "vip:revoke": "tsx prisma/vip.ts revoke",
    "vip:grant:prod": "node dist/prisma/vip.js grant",
    "vip:revoke:prod": "node dist/prisma/vip.js revoke",
    "test:agent-batch": "tsx scripts/agent-batch-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@prisma/client": "6.12.0",
    "@tanstack/react-query": "5.104.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "4.22.3",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.4.0",
    "nodemailer": "10.0.11",
    "pino": "9.14.0",
    "prisma": "6.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "24.5.2",
    "@types/nodemailer": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "15.5.2",
    "playwright-core": "^1.63.0",
    "prettier": "3.9.9",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
