{
  "name": "personal-finance-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend hệ thống sổ thu chi cá nhân - TASK_00030",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-live.mjs",
    "test:ui": "node scripts/ui-e2e.mjs",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "node dist/prisma/seed.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "4.22.3",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.4.0",
    "nodemailer": "10.0.11",
    "prisma": "6.12.0",
    "swagger-ui-express": "5.0.1",
    "yamljs": "0.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "24.5.2",
    "@types/nodemailer": "7.0.2",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@types/yamljs": "0.2.34",
    "@vitest/coverage-v8": "4.1.11",
    "playwright-core": "^1.63.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
