NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://finance:finance_secret@localhost:5432/personal_finance?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_MINUTES=15
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=5
# Bỏ trống SMTP_HOST để dùng chế độ dev (reset link được ghi ra console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@finance.local
COOKIE_NAME=finance_refresh
COOKIE_SECURE=false
# OAuth (tùy chọn). Callback: {APP_URL}/api/v1/auth/oauth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:3000
# Trợ lý thông minh chạy local theo mặc định; thêm khóa để dùng OpenAI.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
